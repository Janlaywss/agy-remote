#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

ROOT = Path.home() / "Library/Logs/agy-mac/jobs"
os.umask(0o077)

def save(path, value):
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(value))
    tmp.replace(path)

def worker(folder):
    request = json.loads((folder / "request").read_text())
    (folder / "request").unlink()
    status = {"state": "running", "cwd": str(Path.cwd()), "started": time.time()}
    try:
        with (folder / "output").open("wb") as out:
            proc = subprocess.Popen(["/bin/zsh", "-lc", request["command"]], stdout=out,
                                    stderr=subprocess.STDOUT, start_new_session=True,
                                    env={**os.environ, "PYTHONUNBUFFERED": "1"})
            status["pid"] = proc.pid
            save(folder / "status", status)
            try:
                status["exit"] = proc.wait(timeout=request.get("timeout"))
                status["state"] = "finished"
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                status.update(state="timed-out", exit=proc.wait())
    except Exception as exc:
        status.update(state="failed", exit=1, error=str(exc))
    save(folder / "status", status)

def inspect(folder, limit=16000):
    path = folder / "status"
    state = json.loads(path.read_text()) if path.exists() else {"state":"starting"}
    if state["state"] == "running":
        try:
            os.kill(state["pid"], 0)
        except ProcessLookupError:
            # Worker may be finishing its atomic final update.
            state = json.loads(path.read_text())
            if state["state"] == "running":
                state["state"] = "process exited; final status pending or unavailable"
    print(folder.name, json.dumps(state, ensure_ascii=False))
    log = folder / "output"
    if log.exists():
        print("Log:", log)
        with log.open("rb") as f:
            f.seek(max(0, log.stat().st_size-limit))
            print(f.read(limit).decode(errors="replace"))

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["run","status","list","worker"])
    parser.add_argument("job", nargs="?")
    args = parser.parse_args()
    ROOT.mkdir(parents=True, exist_ok=True)
    if args.action == "list":
        for path in sorted(ROOT.glob("job-*"), key=lambda p:p.stat().st_mtime, reverse=True)[:50]:
            if (path/"status").exists():
                print(path.name, (path/"status").read_text())
        return
    if args.action != "run":
        if not re.fullmatch(r"job-[a-z0-9_]+", args.job or "") or not (ROOT/args.job).is_dir():
            parser.error("Unknown job ID")
        folder = ROOT / args.job
        return worker(folder) if args.action == "worker" else inspect(folder)
    request = json.load(sys.stdin)
    folder = Path(tempfile.mkdtemp(prefix="job-",dir=ROOT))
    save(folder/"request",request)
    proc = subprocess.Popen([sys.executable,__file__,"worker",folder.name],start_new_session=True,
                            stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        inspect(folder)
        print("Check with agy-mac-job status", folder.name)
        return
    status = json.loads((folder/"status").read_text())
    with (folder/"output").open("rb") as f:
        data=f.read(100001)
    sys.stdout.buffer.write(data[:100000])
    if len(data)>100000:
        print("\nFull log:", folder/"output")
    else:
        shutil.rmtree(folder)
    return status["exit"] if status["exit"] >= 0 else 128-status["exit"]

if __name__ == "__main__":
    sys.exit(main())
